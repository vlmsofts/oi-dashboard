_check_js.py
fix_fnd.py
migrate_options_commodity.py
test_*.py
build_whatsapp_oi old all commods.py

# Environment secrets
.env

# ICE preliminary OI: inbound CSVs pulled from email by prelim_oi_watcher.py,
# and generated report output. Source data arrives daily; not version-controlled.
data/prelim_inbox/
output/prelim/

# Pre-backfill snapshot of oi_data.csv (2026-08-17 cycle-3 merge)
data/oi_data.csv.BEFORE_CYCLE3

# vlm_daily_data_guard runtime artifacts (local state, never shared)
vlm_daily_data_guard.log
.guard_alerted_*
